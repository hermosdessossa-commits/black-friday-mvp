# Configuration de l'application Black Friday
# Copier ce fichier vers .env.local et remplir les valeurs

# Mode démo (simule le paiement sans Stripe)
# true = mode démo (par défaut), false = mode réel avec Stripe
NEXT_PUBLIC_DEMO_MODE=true

# URL publique du site (utilisée pour les URLs de retour Stripe, canonical, sitemap, etc.)
# En production sur Vercel, NEXT_PUBLIC_SITE_URL est déduit de VERCEL_URL automatiquement
# NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr

# Clé secrète Stripe (JAMAIS committer une vraie clé !)
# Obtenue sur https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_... ou sk_test_...

# Clé publique Stripe (optionnelle, pour Stripe.js côté client)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... ou pk_test_...

# Fin des offres (format ISO 8601 avec fuseau horaire)
# Par défaut: fin du Cyber Monday 2026 (30 novembre 2026 à 23h59 heure de Paris)
# SALE_ENDS_AT=2026-11-30T23:59:59+01:00

# Pays de livraison (codes ISO 3166-1 alpha-2, séparés par des virgules)
# SHIPPING_COUNTRIES=FR,BE,CH,LU,MC